{
  "compilerOptions": {
      "strict": true,
      "types": ["webextension-polyfill"],
      "lib": ["dom", "esnext", "webworker"],
      "module": "esnext",
      "moduleResolution": "node",
      "target": "es6",
      "esModuleInterop": true,
      "sourceMap": true,
      "rootDir": "src",
      "outDir": "dist",
      "noEmitOnError": true,
      "jsx": "react-jsx",
      "typeRoots": [
          "node_modules/@types"
      ]
  }
}