{
  "name": "ucan-chrome-ext",
  "version": "1.0.1",
  "description": "Devtools extension to look at web requests",
  "main": "index.js",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode production --watch",
    "build:safari": "BUILD_TARGET=safari webpack --mode production",
    "dev:safari": "BUILD_TARGET=safari webpack --mode production --watch",
    "safari:convert": "npm run build:safari && xcrun safari-web-extension-converter dist --project-location ./safari --app-name \"UCAN See My Request\" --bundle-identifier \"network.storacha.ucansee\" --copy-resources --no-open",
    "safari:clean": "rm -rf safari && rm -rf dist"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.20",
    "@mui/material": "^5.15.20",
    "@types/chrome": "^0.0.193",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@ucanto/core": "^10.0.1",
    "@ucanto/transport": "^9.1.1",
    "browser-sync": "^2.27.10",
    "browser-sync-webpack-plugin": "^2.3.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^7.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "^5.0.1",
    "styled-components": "^6.1.11",
    "ts-loader": "^9.5.1",
    "typescript": "^4.7.4",
    "webpack": "^5.73.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.9.3"
  },
  "dependencies": {
    "duration": "^0.2.2",
    "react-resplit": "^1.3.2"
  }
}
